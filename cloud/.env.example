# HoYoCalendar Cloud API — 环境变量模板
# 复制为 .env 并填写真实值；敏感项一律只放在服务器 .env，绝不提交仓库或评论。

# ---------- 数据库 ----------
# PostgreSQL 连接串。密码请替换为部署时实际生成的强口令。
DATABASE_URL=postgresql+psycopg2://hoyo:CHANGE_ME@127.0.0.1:5432/hoyocalendar

# ---------- 认证 ----------
# JWT 签名密钥（必填，≥32 字符随机串），用于签发访问/管理令牌。
JWT_SECRET=
# 访问令牌有效期（分钟）
ACCESS_TOKEN_MINUTES=15
# 刷新令牌有效期（天）
REFRESH_TOKEN_DAYS=30
# 每账号最大设备数
MAX_DEVICES=5
# 邀请码默认有效期（天）
INVITE_EXPIRES_DAYS=30

# ---------- 同步 ----------
TRASH_RETENTION_DAYS=30
TOMBSTONE_RETENTION_DAYS=180

# ---------- 云端 Agent ----------
# 管理员总开关（false 时仅 AI 服务暂停，日历/同步不受影响）
AI_ENABLED=true
# OpenAI-compatible 服务地址与密钥；留空则 AI 返回“未配置”
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_CONCURRENCY=4
# 每个会话最多保留的 user/assistant 消息总数
AGENT_HISTORY_MESSAGES=8
# 会话历史保留天数；写入后清理过期记录
AGENT_SESSION_TTL_DAYS=7
AGENT_SESSION_CLEANUP_AFTER_WRITE=true
# 平台全局月度预算（美元）；0 表示不设上限
AI_MONTHLY_BUDGET_USD=0

# ---------- 管理后台 ----------
ADMIN_USERNAME=admin
# Argon2id 哈希。生成：python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('你的密码'))"
ADMIN_PASSWORD_HASH=
# 管理令牌签名密钥（必填，≥32 字符随机串）
ADMIN_TOKEN_SECRET=

# ---------- 运行 ----------
API_HOST=127.0.0.1
API_PORT=8000
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8001
LOG_LEVEL=INFO
# 仅这些直连代理可以提供 X-Forwarded-For；默认仅信任本机 nginx
TRUSTED_PROXIES=127.0.0.1,::1
